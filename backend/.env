# ============================================
# STREAMPREMIUM - CONFIGURAÇÕES DO SERVIDOR
# ============================================

# Porta do servidor
PORT=3000

# Chave secreta para geração de tokens JWT
JWT_SECRET=streampremium_super_secret_key_2024_change_me_in_production

# Tempo de expiração do token JWT
JWT_EXPIRES=7d

# ============================================
# BANCO DE DADOS
# ============================================

# Tipo de banco de dados (mysql, postgres, sqlite, mongodb)
DB_TYPE=sqlite

# Host do banco de dados (para mysql/postgres)
DB_HOST=localhost

# Porta do banco de dados
DB_PORT=3306

# Nome do banco de dados
DB_NAME=streampremium

# Usuário do banco de dados
DB_USER=root

# Senha do banco de dados
DB_PASSWORD=

# ============================================
# E-MAIL (SMTP)
# ============================================

# Servidor SMTP
SMTP_HOST=smtp.gmail.com

# Porta SMTP
SMTP_PORT=587

# Usuário SMTP
SMTP_USER=suporte@streampremium.com

# Senha SMTP
SMTP_PASSWORD=

# E-mail de origem
EMAIL_FROM=suporte@streampremium.com

# ============================================
# INTEGRAÇÕES DE PAGAMENTO
# ============================================

# Chave da API do Stripe
STRIPE_SECRET_KEY=

# Chave pública do Stripe
STRIPE_PUBLIC_KEY=

# Chave da API do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=

# Chave da API do PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================

# Habilitar CORS para origens específicas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Limite de requisições (por minuto)
RATE_LIMIT_MAX=100

# ============================================
# CONFIGURAÇÕES DE LOG
# ============================================

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# CONFIGURAÇÕES DE ARQUIVOS
# ============================================

# Diretório de uploads
UPLOAD_DIR=uploads

# Tamanho máximo de upload (em MB)
MAX_UPLOAD_SIZE=50

# ============================================
# REDIS (opcional, para cache)
# ============================================

# Host do Redis
REDIS_HOST=localhost

# Porta do Redis
REDIS_PORT=6379

# Senha do Redis
REDIS_PASSWORD=

# ============================================
# AMBIENTE
# ============================================

# Ambiente de execução (development, production, test)
NODE_ENV=development
